  "owner_decisions_to_resolve": [
    {
      "id": "F01-1",
      "question": "3ペアに対しどの環境のMT4属性を安全に観測するか。既存デモ口座はEA/建玉があり無断使用不可。",
      "proposal": "口座同一性と単一セッションを示す事前確認・権限を分離してから別途本人が閲覧方式を承認。",
      "owner_status": "UNDECIDED",
      "approval_reference": null
    },
    {
      "id": "F01-2",
      "question": "実MT4でEUR/USDのシンボル/契約サイズ/lot/point/tick・tick-valueの単位を何で確証するか。",
      "proposal": "3ペア各5主要属性の時刻・情報源・別経路照合を要求し、数値未確認時は拒否。",
      "owner_status": "UNDECIDED",
      "approval_reference": null
    },
    {
      "id": "F01-3",
      "question": "口座通貨とquote通貨、USD/JPY換算の整合をどの独立証拠で確認するか。",
      "proposal": "EUR/USDのUSD建てquote損益とJPY入金通貨の換算経路を別のFORM-03で審査。",
      "owner_status": "UNDECIDED",
      "approval_reference": null
    },
    {
      "id": "F01-4",
      "question": "契約属性の変更をどう検出し、いつ再検証するか。",
      "proposal": "契約値/出典/バージョンが不明または変化したら保守的に新規拒否、再検証/本人承認待ち。",
      "owner_status": "UNDECIDED",
      "approval_reference": null
    },
    {
      "id": "F01-5",
      "question": "0.01lot相当等の最小取引数量で10万円の0.5%を守れるか。",
      "proposal": "ブローカー契約証拠とFORM-02/03/04/07の未承認計算結果が揃うまで評価不可。",
      "owner_status": "UNDECIDED",
      "approval_reference": null
    }
  ],
  "known_legacy_limitations": [
    "過去の4ペアの実口座目視報告は3ペアG1の契約確認を証明しない",
