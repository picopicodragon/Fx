  "guarantees": [
    {
      "id": "SR-01",
      "invariant": "Stop reasons remain individually addressable and are never globally cleared by a different reason's recovery.",
      "basis": [
        "Q121"
      ]
    },
    {
      "id": "SR-02",
      "invariant": "An uncleared or unknown order-blocking reason forbids new orders; partial recovery is not global permission.",
      "basis": [
        "Q121",
        "Q104"
      ]
    },
    {
      "id": "SR-03",
      "invariant": "Stop state must be recoverable after restart; unavailable, inconsistent or unverified persisted state forbids new orders.",
      "basis": [
        "Q121",
        "Q171"
      ]
    },
    {
      "id": "SR-04",
      "invariant": "DD4 and DD5 order stop cannot be automatically cleared by DD improvement; explicit human approval plus required safety verification remain necessary.",
      "basis": [
        "Q12",
        "Q80",
        "Q122"
      ]
    },
    {
      "id": "SR-05",
      "invariant": "Performance deterioration LEVEL3 clearance requires safety check and explicit human approval. LEVEL1/2 return only to normal monitoring, not order authorization.",
      "basis": [
        "Q80",
        "Q121"
      ]
    },
    {
      "id": "SR-06",
      "invariant": "Monitor-only DD2/DD3 recovery cannot clear DD4/5 or other blockers; the adopted below-threshold, 30-minute, fresh clock/operation checks remain applicable.",
      "basis": [
        "Q122",
        "Q123",
        "Q124",
        "Q125",
        "Q126",
        "Q127",
        "Q128",
        "Q147"
      ]
    },
    {
      "id": "SR-07",
      "invariant": "Communication L1/L2/L3 are a different namespace from performance LEVEL1/2/3. Serious communication and isolation failure latches cannot be released by mere reconnection, process restart or a different monitor reset.",
      "basis": [
        "Q44",
        "Q45",
        "Q121",
        "Q171"
      ]
    },
    {
      "id": "SR-08",
      "invariant": "Daily loss stop may only conditionally clear after next NY17:00 trading-day boundary and completed safety checks; it cannot clear human-gated DD or performance stops.",
      "basis": [
        "Q9",
        "Q10",
        "Q14",
        "Q118",
        "Q121"
      ]
    },
    {
      "id": "SR-09",
      "invariant": "A close-out retry is not authorized when execution outcome is unknown; independent broker/position/order/SL reconciliation must establish duplicate/reversal safety first.",
      "basis": [
        "Q120",
        "Q195",
        "Q196",
        "Q197",
        "Q198",
        "Q199"
      ]
    },
    {
      "id": "SR-10",
      "invariant": "PHASE-1 BLOCKED and forward_trading_enabled=false prohibit live orders even if hypothetical active-stop set is empty.",
      "basis": [
        "Q104",
        "Q107",
        "Q110"
      ]
    }
