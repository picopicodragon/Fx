      "requirement": "FORM-01",
      "note": "Never round up to minimum or to nearest step solely to place order."
    },
    {
      "v2_field": "point_quote",
      "official_mql4_property": "MODE_POINT",
      "value_unit": "quote_currency_price_per_base_unit",
      "constraint": "finite_positive_decimal",
      "data_scope": "ACCOUNT_SYMBOL",
      "requirement": "FORM-01",
      "note": "Quote price point differs from tick size expressed in points. Compare MODE_DIGITS and public point rule."
    },
    {
      "v2_field": "tick_size_points",
      "official_mql4_property": "MODE_TICKSIZE",
      "value_unit": "points_per_tick",
      "constraint": "finite_positive_decimal",
      "data_scope": "ACCOUNT_SYMBOL",
      "requirement": "FORM-01",
      "note": "For tick price increment multiply point_quote by tick_size_points; do not assume tick_size_points=1."
    },
    {
      "v2_field": "tick_value_deposit_currency",
      "official_mql4_property": "MODE_TICKVALUE",
      "value_unit": "deposit_currency_per_tick_at_reported_contract_basis",
      "constraint": "finite_positive_decimal",
      "data_scope": "ACCOUNT_SYMBOL_DYNAMIC_CONVERSION_SENSITIVE",
      "requirement": "FORM-01/FORM-03",
      "note": "MQL4 docs describe value in account deposit currency; exact symbol/lot basis and independently observed broker results must be corroborated before risk formulas."
    }
  ],
